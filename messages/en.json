    "journey": {
      "eyebrow": "The Journey",
      "title": "Spore to Table",
      "subtitle": "Every harvest begins with precision. Follow the journey from inoculation to your plate.",
      "steps": {
        "1": {
          "phase": "Prepare",
          "title": "Substrate & Spawn",
          "description": "Mix sterilized substrate with grain spawn under sterile conditions. Rye berries, straw, or sawdust — every species has its ideal medium.",
          "timing": "Day 1",
          "imageAlt": "Blue oyster mushroom cluster on substrate",
          "image": "https://drzwclnecktguodpokir.supabase.co/storage/v1/object/public/product-images/1788523252817-blue-oyster.png"
        },
        "2": {
          "phase": "Colonize",
          "title": "Mycelium Takeover",
          "description": "In the dark, white threads spread through the substrate, building the underground network. Don't touch it. Just wait.",
          "timing": "Weeks 1–3",
          "imageAlt": "Blue oyster mushroom cluster colonizing",
          "image": "https://drzwclnecktguodpokir.supabase.co/storage/v1/object/public/product-images/1788523252817-blue-oyster.png"
        },
        "3": {
          "phase": "Fruit",
          "title": "Pins Break Through",
          "description": "Lower CO₂, raise humidity. Tiny pins push through the surface. The moment life emerges from nothing — always magical.",
          "timing": "Week 3–4",
          "imageAlt": "Pink Oyster pins emerging",
          "image": "https://images.unsplash.com/photo-1773600149997-2b6af77031d7?w=520&h=620&q=85&auto=format&fit=crop"
        },
        "4": {
          "phase": "Harvest",
          "title": "The Pure Harvest",
          "description": "Twist and pull just before the veil breaks. First flush — pure reward for your precision and patience. Plate it. Extract it. Grow again.",
          "timing": "Week 4–5",
          "imageAlt": "Golden Oyster ready to harvest",
          "image": "https://images.unsplash.com/photo-1748118869505-e75f25812a70?w=520&h=620&q=85&auto=format&fit=crop"
        }
      }
    },
