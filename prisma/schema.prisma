generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// The tenant. Each client business (Frontier Lab today, others later) is one Store row —
// every catalog/order/customer-activity model below is scoped to one via storeId.
model Store {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Details that appear to customers on packing slips and order emails. Kept here rather than
  // hardcoded so a rename or a new support address never needs a code change.
  supportEmail  String  @default("")
  addressLine1  String  @default("")
  addressLine2  String  @default("")
  city          String  @default("")
  state         String  @default("")
  postalCode    String  @default("")
  country       String  @default("US")
  // Low stock warning threshold: variants at or below this are flagged in the admin. 0 disables.
  lowStockThreshold Int @default(0)

  // Brand colours as hex, each empty by default meaning "use the palette the site ships with".
  // Applied as CSS variables at render time — see lib/theme.ts.
  themeAccent    String @default("")
  themeAmber     String @default("")
  themeInk       String @default("")
  themeInkMuted  String @default("")
  themeBg        String @default("")
  themeSurface   String @default("")
  themeElevated  String @default("")
  themeBorder    String @default("")

  // ISO 4217, lower case, as Stripe expects it. Changing this does not convert existing prices.
  currency String @default("usd")
  // The public domain, once one is connected — used for canonical links, the sitemap and emails.
  domain   String @default("")

  // Shipping, in cents. A discount code can never cover shipping — Stripe applies discounts to
  // the subtotal only — so free shipping is granted here, at the moment the session is built.
  shippingRate           Int  @default(999)
  // freeShippingThreshold: order subtotal at or above which shipping is free; 0 disables it.
  freeShippingThreshold  Int  @default(0)

  members        StoreMember[]
  species        Species[]
  products       Product[]
  collections    Collection[]
  variants       ProductVariant[]
  orders         Order[]
  orderItems     OrderItem[]
  orderEvents    OrderEvent[]
  customerProfiles CustomerProfile[]
  siteContent      SiteContent[]
  pages            Page[]
  posts            Post[]
  homeSections     HomeSection[]
  taxRates         TaxRate[]
  shippingZones    ShippingZone[]
  shippingRates    ShippingRate[]
  giftCards        GiftCard[]
  locations        Location[]
  inventoryLevels  InventoryLevel[]
  emailTemplates   EmailTemplate[]
  journalEntries GrowJournalEntry[]
  wishlistItems  WishlistItem[]
  subscribers    NewsletterSubscriber[]
  reviews        Review[]

  @@map("stores")
}

// Maps a Supabase auth.users.id (bare string — no Prisma-managed User table, same pattern as
// Order.userId/WishlistItem.userId below) to the Store they administer. One login = one store.
// A customer is normally derived by grouping orders by email — there is no customer table,
// because the checkout is guest-only. This holds only what an admin adds by hand about an
// email address, so a customer with no notes and no tags simply has no row here.
model CustomerProfile {
  id        String   @id @default(cuid())
  storeId   String
  email     String
  notes     String   @default("")
  tags      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id])

  @@unique([storeId, email])
  @@index([storeId])
  @@map("customer_profiles")
}

// One override for one translation key, e.g. "home.hero.title". Only keys the owner has
// actually edited get a row; everything else falls back to the text shipped in messages/*.json,
// so the site never depends on this table being complete.
model SiteContent {
  id        String   @id @default(cuid())
  storeId   String
  key       String
  valueEn   String   @db.Text
  valueEs   String   @db.Text
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id])

  @@unique([storeId, key])
  @@index([storeId])
  @@map("site_content")
}


// ── Content ───────────────────────────────────────────────────────────────────

// A page the owner composes from blocks in /admin/pages. Replaces having page copy live in
// .tsx files, which is why the legal pages could not be edited from the panel.
model Page {
  id              String   @id @default(cuid())
  storeId         String
  slug            String
  titleEn         String
  titleEs         String
  // Array of { id, type, data } — see lib/page-blocks.ts for the shapes each type accepts.
  blocks          Json     @default("[]")
  status          String   @default("draft") // 'draft' | 'active'
  metaTitle       String?
  metaDescription String?
  showInFooter    Boolean  @default(false)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id])

  @@unique([storeId, slug])
  @@index([storeId])
  @@map("pages")
}

model Post {
  id              String    @id @default(cuid())
  storeId         String
  slug            String
  titleEn         String
  titleEs         String
  excerptEn       String    @default("") @db.Text
  excerptEs       String    @default("") @db.Text
  bodyEn          String    @default("") @db.Text
  bodyEs          String    @default("") @db.Text
  coverImage      String?
  status          String    @default("draft") // 'draft' | 'active'
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  store Store @relation(fields: [storeId], references: [id])

  @@unique([storeId, slug])
  @@index([storeId])
  @@map("posts")
}

// Which blocks the home page shows and in what order. Rows are created on first visit to
// /admin/appearance from the known section keys, so the code stays the source of what exists.
model HomeSection {
  id        String  @id @default(cuid())
  storeId   String
  key       String
  enabled   Boolean @default(true)
  sortOrder Int     @default(0)

  store Store @relation(fields: [storeId], references: [id])

  @@unique([storeId, key])
  @@index([storeId])
  @@map("home_sections")
}

// ── Commerce settings ─────────────────────────────────────────────────────────

// Sales tax applied at checkout. Stored in basis points (825 = 8.25%) to avoid float drift.
model TaxRate {
  id          String  @id @default(cuid())
  storeId     String
  name        String
  country     String
  // Null means the rate covers the whole country rather than one state or region.
  state       String?
  basisPoints Int
  enabled     Boolean @default(true)

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@map("tax_rates")
}

model ShippingZone {
  id        String   @id @default(cuid())
  storeId   String
  name      String
  countries String[]
  sortOrder Int      @default(0)

  store Store          @relation(fields: [storeId], references: [id])
  rates ShippingRate[]

  @@index([storeId])
  @@map("shipping_zones")
}

// A rate inside a zone. The bounds are optional and inclusive-exclusive: a rate applies when the
// order's subtotal and weight both fall inside whatever bounds are set.
model ShippingRate {
  id             String  @id @default(cuid())
  storeId        String
  zoneId         String
  name           String
  amount         Int
  minSubtotal    Int?
  maxSubtotal    Int?
  minWeightGrams Int?
  maxWeightGrams Int?
  minDays        Int     @default(3)
  maxDays        Int     @default(5)
  sortOrder      Int     @default(0)

  store Store        @relation(fields: [storeId], references: [id])
  zone  ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([zoneId])
  @@map("shipping_rates")
}

// Balance is what remains; initialAmount never changes, so the history is readable from the row.
model GiftCard {
  id            String    @id @default(cuid())
  storeId       String
  code          String    @unique
  initialAmount Int
  balance       Int
  status        String    @default("active") // 'active' | 'disabled'
  note          String    @default("")
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@map("gift_cards")
}

// ── Inventory locations ───────────────────────────────────────────────────────

model Location {
  id        String  @id @default(cuid())
  storeId   String
  name      String
  address   String  @default("")
  isDefault Boolean @default(false)

  store  Store            @relation(fields: [storeId], references: [id])
  levels InventoryLevel[]

  @@index([storeId])
  @@map("locations")
}

// Stock of one variant at one location. ProductVariant.stock stays as the total the storefront
// reads, kept in step with the sum of these rows — the storefront must not have to join.
model InventoryLevel {
  id         String @id @default(cuid())
  storeId    String
  variantId  String
  locationId String
  quantity   Int    @default(0)

  store    Store    @relation(fields: [storeId], references: [id])
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([variantId, locationId])
  @@index([storeId])
  @@map("inventory_levels")
}

// An editable version of a transactional email. Only the wording is stored — the layout, the
// order table and the totals are built in code, so a saved template can never break an email.
model EmailTemplate {
  id        String   @id @default(cuid())
  storeId   String
  key       String // 'orderConfirmation'
  subjectEn String   @default("")
  subjectEs String   @default("")
  headingEn String   @default("")
  headingEs String   @default("")
  introEn   String   @default("") @db.Text
  introEs   String   @default("") @db.Text
  footerEn  String   @default("") @db.Text
  footerEs  String   @default("") @db.Text
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id])

  @@unique([storeId, key])
  @@index([storeId])
  @@map("email_templates")
}

model StoreMember {
  id        String   @id @default(cuid())
  storeId   String
  userId    String
  role      String   @default("staff") // 'owner' | 'staff'
  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
  @@index([userId])
  @@map("store_members")
}

model Species {
  id                   String   @id @default(cuid())
  storeId              String
  slug                 String   @unique
  commonName           String
  scientificName       String
  family               String
  order                String
  type                 String
  difficulty           String
  substrate            String[]
  colonizationWeeksMin Int
  colonizationWeeksMax Int
  fruitingTempFMin     Int
  fruitingTempFMax     Int
  fruitingTempCMin     Int
  fruitingTempCMax     Int
  expectedFlushes      Int
  biologicalEfficiency String
  betaGlucanContent    String
  indoorOutdoor        String
  descriptionEn        String   @db.Text
  descriptionEs        String   @db.Text
  cultivationNotesEn   String   @db.Text
  cultivationNotesEs   String   @db.Text
  medicalNotesEn       String   @db.Text
  medicalNotesEs       String   @db.Text
  cookingNotesEn       String   @db.Text
  cookingNotesEs       String   @db.Text
  lookalikes           String[]
  imageUrl             String
  thumbnailUrl         String
  openartPrompt        String?
  // Icon + label + detail benefit cards shown on the encyclopedia detail page. Shape matches
  // SpeciesBenefit in lib/species-data.ts.
  keyBenefits          Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  store    Store    @relation(fields: [storeId], references: [id])
  products Product[]

  @@index([storeId])
  @@map("species")
}

model Product {
  id             String   @id @default(cuid())
  storeId        String
  slug           String   @unique
  nameEn         String
  nameEs         String
  descriptionEn  String   @db.Text
  descriptionEs  String   @db.Text
  category       String
  subcategory    String
  status         String   @default("draft") // 'draft' | 'active' | 'archived' — controls visibility on the live site, separate from `inStock` (purchasability)
  speciesId      String?
  scientificName String?
  price          Int
  compareAtPrice Int?
  images         String[]
  // Alt text, index-aligned with `images` (imageAlts[i] describes images[i]). The admin form
  // keeps both arrays in sync on add/remove/reorder; a missing entry falls back to the product name.
  imageAlts      String[] @default([])
  isOrganic      Boolean  @default(false)
  inStock        Boolean  @default(true)
  tags           String[]
  relatedProducts String[]

  // Search-engine overrides. Both are optional and locale-agnostic: the admin is English-only,
  // and when they are empty the page falls back to the product name and description.
  metaTitle       String?
  metaDescription String?

  // Whether sales tax applies to this product. Physical goods are taxable; a digital guide or a
  // gift card would not be. Nothing calculates tax yet — this records the fact for when it does.
  taxable Boolean @default(true)

  specsDifficulty      String?
  specsColonizationTime String?
  specsFruitingTempF   String?
  specsFruitingTempC   String?
  specsIdealSubstrate  String?
  specsExpectedYield   String?
  specsIndoorOutdoor   String?

  // Rich per-product content carried over from the hardcoded catalog as-is — nested/bilingual
  // shape doesn't map cleanly to relational columns, and the admin UI doesn't edit these yet
  // (see CLAUDE.md Backlog #16). Shapes match types/product.ts's Product interface.
  howToUseSteps  Json?
  faqs           Json?
  scienceContent Json?
  keyBenefits    Json?
  grainBagSpecs  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store          Store           @relation(fields: [storeId], references: [id])
  species        Species?         @relation(fields: [speciesId], references: [id])
  variants       ProductVariant[]
  wishlistItems  WishlistItem[]
  collections    Collection[]

  @@index([storeId])
  @@map("products")
}

model Collection {
  id            String   @id @default(cuid())
  storeId       String
  slug          String   @unique
  titleEn       String
  titleEs       String
  descriptionEn String?  @db.Text
  descriptionEs String?  @db.Text
  image         String?
  // An automatic collection derives its products from a rule instead of a hand-picked list:
  // every product matching the rule belongs, including ones added later. Null means manual.
  ruleField     String? // 'category' | 'subcategory' | 'tag'
  ruleValue     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  store    Store    @relation(fields: [storeId], references: [id])
  products Product[]

  @@index([storeId])
  @@map("collections")
}

model ProductVariant {
  id        String  @id @default(cuid())
  storeId   String
  productId String
  name      String
  price     Int
  stock     Int     @default(0)
  sku       String  @unique
  // What this unit costs you, in cents. Never shown to customers — it exists so the admin can
  // report margin. Null means it has not been entered yet, which is not the same as zero cost.
  cost        Int?
  // Shipping weight in grams. Whole grams are enough for a carrier rate and avoid float drift.
  weightGrams Int?

  store   Store  @relation(fields: [storeId], references: [id])
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("product_variants")
}

model Order {
  id                    String   @id @default(cuid())
  storeId               String
  userId                String? // Supabase auth.users.id — no Prisma relation, that schema isn't Prisma-managed
  email                 String
  status                String   @default("pending") // 'pending' | 'paid' | 'fulfilled' | 'cancelled' | 'refunded'
  subtotal              Int
  shipping              Int      @default(0)
  tax                   Int      @default(0)
  total                 Int
  stripePaymentIntentId String?
  trackingNumber        String?
  shippingName          String
  shippingLine1         String
  shippingLine2         String?
  shippingCity          String
  shippingState         String
  shippingPostalCode    String
  shippingCountry       String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  store  Store        @relation(fields: [storeId], references: [id])
  items  OrderItem[]
  events OrderEvent[]

  @@index([storeId])
  @@index([email])
  @@map("orders")
}

// Append-only history of everything that happened to an order: placed, fulfilled, tracking
// added, cancelled, refunded, email sent. Never edited or deleted — it exists so a dispute can
// be answered with what actually happened and who did it.
model OrderEvent {
  id         String   @id @default(cuid())
  storeId    String
  orderId    String
  type       String // 'placed' | 'status' | 'fulfilment' | 'tracking' | 'cancelled' | 'refunded' | 'email' | 'note'
  message    String
  actorEmail String? // null when the system wrote it (the Stripe webhook)
  createdAt  DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id])

  @@index([orderId])
  @@index([storeId])
  @@map("order_events")
}

model OrderItem {
  id        String  @id @default(cuid())
  storeId   String // denormalized from Order — lets analytics scope OrderItem without joining through Order
  orderId   String
  productId String
  variantId String
  name      String
  price     Int
  quantity  Int
  image     String
  // Units already shipped. Partial fulfilment is normal when one line is out of stock: the
  // order stays open until every line has caught up with its quantity.
  fulfilledQuantity Int @default(0)

  store Store @relation(fields: [storeId], references: [id])
  order Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("order_items")
}

model GrowJournalEntry {
  id          String   @id @default(cuid())
  storeId     String
  userId      String // Supabase auth.users.id — no Prisma relation, that schema isn't Prisma-managed
  species     String
  speciesSlug String
  method      String
  substrate   String
  startDate   DateTime
  notes       String   @db.Text
  status      String   @default("inoculated")
  photos      String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@map("grow_journal_entries")
}

model WishlistItem {
  id        String   @id @default(cuid())
  storeId   String
  userId    String // Supabase auth.users.id — no Prisma relation, that schema isn't Prisma-managed
  productId String
  createdAt DateTime @default(now())

  store   Store  @relation(fields: [storeId], references: [id])
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([storeId])
  @@map("wishlist_items")
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  storeId   String
  email     String   @unique
  locale    String   @default("en")
  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@map("newsletter_subscribers")
}

model Review {
  id          String   @id @default(cuid())
  storeId     String
  name        String
  email       String
  rating      Int
  comment     String
  productName String?
  locale      String   @default("en")
  createdAt   DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@map("reviews")
}
